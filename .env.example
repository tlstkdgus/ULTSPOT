# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.

# ── Supabase ─────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
# 브라우저에 노출돼도 되는 키만 NEXT_PUBLIC_ 으로 둔다 (RLS가 실제 보호막).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DB migration 적용 + Anonymous Sign-Ins 활성화 + 별도 브라우저 2개로 RLS 검증 후 true.
# 공개 탐색·일정 생성·기기 저장에는 필요 없음. 운영 전 보존/삭제·봇 방어 설정 검토.
NEXT_PUBLIC_ENABLE_CLOUD_TRIPS=false

# ── 카카오맵 (지도·주소 검색·대중교통/도보 경로) ─────────
# 이 앱은 카카오 키를 둘 쓴다. 역할이 다르고 노출 규칙도 반대다 — 섞지 말 것.
#
# [1] REST API 키 — 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 발급: developers.kakao.com → 앱 → 제품 설정 → 카카오맵 → 사용 설정 → 앱 키의 REST API 키
# 심사 없음. 대중교통/도보 경로는 첫 활성화 앱 기준 일 1,000건 무료, 초과 시 건당 10원.
# 자세한 비교와 절차: docs/specs/map-and-routing.md
# 비어 있으면 모든 구간이 "이동시간 미확인"으로 표시된다 (계획용 여유 시간으로 일정은 계산된다).
# KAKAO_REST_API_KEY=

# [2] JavaScript 키 — 지도를 브라우저에 그린다. 위 REST 키와 다른 키다.
# 발급: 같은 앱 → 앱 키의 JavaScript 키. 카카오 콘솔에서 허용 도메인으로 묶이는 브라우저용
# 키라 노출이 설계상 전제이며, 그래서 NEXT_PUBLIC_ 을 붙인다.
# 이름을 정확히 지킬 것 — src/components/kakao-map.tsx 가 이 이름만 읽는다. Vercel에
# KAKAO_JS_KEY 로 등록돼 있어 지도가 아무 데서도 안 뜬 적이 있다 (T-040). 키가 없으면
# 지도를 그리지 않고 핀 목록·카카오맵 링크로 떨어지므로 화면이 깨지지 않아 눈에 띄지 않는다.
# NEXT_PUBLIC_ 값은 빌드 시각에 번들로 들어간다. Vercel에 추가만 하고 재배포하지 않으면
# 반영되지 않는다.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 한국관광공사 TourAPI (주변 추천의 영업시간, T-050) ─────
# 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 발급: data.go.kr → 한국관광공사_국문 관광정보 서비스_GW → 활용신청(자동승인) → 일반 인증키.
# 포털의 Decoding 키(%2F 같은 인코딩이 풀린 값)를 넣는다. 코드가 URL 인코딩을 한다.
# 개발계정은 기능별 일 1,000건. 서버 일일 상한: TOUR_DAILY_SEARCH_BUDGET(400)·TOUR_DAILY_HOURS_BUDGET(600).
# 비어 있으면 주변 추천은 카카오 후보만 쓰고 전부 "영업시간 미확인"으로 표시된다.
# TOUR_API_KEY=

# ── Google Maps Platform (지도·장소 사진, T-052) ────────
# 키를 **둘** 만든다. 역할과 노출 규칙이 반대다 — 카카오와 같은 구조.
# 발급: console.cloud.google.com → 프로젝트 → 결제 계정 연결 → API 및 서비스 → 라이브러리에서
#       "Maps JavaScript API"와 "Places API (New)" 사용 설정 → 사용자 인증 정보 → API 키 만들기.
#
# [1] 서버 키 — Places API (New) 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
#     키 제한: 애플리케이션 제한 없음(Vercel은 고정 IP가 없다), API 제한 = Places API (New)만.
#     무료 한도: Text Search Pro 월 5,000 · Place Photo 월 1,000. 서버 일일 상한 GOOGLE_DAILY_PHOTO_BUDGET(30).
# GOOGLE_MAPS_API_KEY=
#
# [2] 브라우저 키 — Maps JavaScript API 전용. 브라우저에 보이는 것이 전제라 NEXT_PUBLIC_ 을 붙인다.
#     키 제한: HTTP 리퍼러 = https://ultspot.vercel.app/*, https://*-tlstkdgus.vercel.app/*, http://localhost:3000/*,
#     http://127.0.0.1:3100/* · API 제한 = Maps JavaScript API만.
#     이 키가 있으면 일정 화면 지도가 Google이 되고, 그때만 Google 장소 사진을 쓴다(Places 약관: 비구글 지도와
#     함께 쓰기 금지). 없으면 카카오 지도이고 Google 사진도 쓰지 않는다.
#     NEXT_PUBLIC_ 값은 빌드 시각에 번들로 들어간다. Vercel에 넣은 뒤 재배포해야 반영된다.
# NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# ── OpenAI (예정) ────────────────────────────────────────
# 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# OPENAI_API_KEY=
