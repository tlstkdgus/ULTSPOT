# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.

# ── Supabase ─────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
# 브라우저에 노출돼도 되는 키만 NEXT_PUBLIC_ 으로 둔다 (RLS가 실제 보호막).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DB migration 적용 + Anonymous Sign-Ins 활성화 + 별도 브라우저 2개로 RLS 검증 후 true.
# 공개 탐색·일정 생성·기기 저장에는 필요 없음. 운영 전 보존/삭제·봇 방어 설정 검토.
NEXT_PUBLIC_ENABLE_CLOUD_TRIPS=false

# ── 카카오맵 (지도·주소 검색·대중교통/도보 경로) ─────────
# 이 앱은 카카오 키를 둘 쓴다. 역할이 다르고 노출 규칙도 반대다 — 섞지 말 것.
#
# [1] REST API 키 — 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 발급: developers.kakao.com → 앱 → 제품 설정 → 카카오맵 → 사용 설정 → 앱 키의 REST API 키
# 심사 없음. 대중교통/도보 경로는 첫 활성화 앱 기준 일 1,000건 무료, 초과 시 건당 10원.
# 자세한 비교와 절차: docs/specs/map-and-routing.md
# 비어 있으면 모든 구간이 "이동시간 미확인"으로 표시된다 (계획용 여유 시간으로 일정은 계산된다).
# KAKAO_REST_API_KEY=

# [2] JavaScript 키 — 지도를 브라우저에 그린다. 위 REST 키와 다른 키다.
# 발급: 같은 앱 → 앱 키의 JavaScript 키. 카카오 콘솔에서 허용 도메인으로 묶이는 브라우저용
# 키라 노출이 설계상 전제이며, 그래서 NEXT_PUBLIC_ 을 붙인다.
# 이름을 정확히 지킬 것 — src/components/kakao-map.tsx 가 이 이름만 읽는다. Vercel에
# KAKAO_JS_KEY 로 등록돼 있어 지도가 아무 데서도 안 뜬 적이 있다 (T-040). 키가 없으면
# 지도를 그리지 않고 핀 목록·카카오맵 링크로 떨어지므로 화면이 깨지지 않아 눈에 띄지 않는다.
# NEXT_PUBLIC_ 값은 빌드 시각에 번들로 들어간다. Vercel에 추가만 하고 재배포하지 않으면
# 반영되지 않는다.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# ── OpenAI (예정) ────────────────────────────────────────
# 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# OPENAI_API_KEY=
