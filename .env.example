# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.

# ── Supabase ─────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
# 브라우저에 노출돼도 되는 키만 NEXT_PUBLIC_ 으로 둔다 (RLS가 실제 보호막).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── OpenAI (예정) ────────────────────────────────────────
# 서버에서만 읽는다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# OPENAI_API_KEY=
